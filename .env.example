# ─────────────────────────────────────────────────────────────────────────────
# IBM Bob 2.0 — Backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# App Configuration
APP_NAME="IBM Bob 2.0 - AI Debugging & Testing Agent"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security & Authentication
# In production, set a strong secret key. Requests should pass 'X-API-Key: <key>'
API_KEY="ibm-bob-secret-key-change-in-production"
REQUIRE_API_KEY=False

# Rate Limiting (SlowAPI format, e.g. "60/minute", "10/second")
RATE_LIMIT_ANALYZE="30/minute"
RATE_LIMIT_DEFAULT="120/minute"

# CORS Configuration (comma-separated list of allowed frontend origins)
#
# LOCAL DEVELOPMENT (default — already set in code, no override needed):
#   CORS_ORIGINS="http://localhost:5180,http://127.0.0.1:5180"
#
# PRODUCTION: replace with the actual deployed frontend URL(s).
#   CORS_ORIGINS="https://app.your-deployed-domain.com"
#
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5180,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5180"

# AI Agent Service (Abinav's AI agent integration)
# When MOCK_AI_AGENT is True, an intelligent mock response is generated for testing without external agent uptime
MOCK_AI_AGENT=True
AI_AGENT_SERVICE_URL="http://localhost:8001/agent/analyze"
AI_AGENT_TIMEOUT_SECONDS=30.0

# Database Configuration (PostgreSQL supported, defaults to SQLite for immediate local zero-dependency run)
DATABASE_URL="sqlite+aiosqlite:///./ibm_bob.db"
# Example PostgreSQL for production deployment:
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/ibm_bob_db"

# Code Safety & Sandboxing Limits
MAX_CODE_SIZE_BYTES=65536
SANDBOX_EXECUTION_TIMEOUT=5.0
