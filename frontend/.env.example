# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy this file to .env.local for local development or .env for CI/production.
# .env.local is git-ignored by default (*.local rule in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
#
# LOCAL DEVELOPMENT:
#   Leave unset — the Vite dev-server proxy forwards /api/* to
#   http://127.0.0.1:8000 automatically (see vite.config.js).
#
# PRODUCTION:
#   Set this to the publicly accessible backend URL before running `npm run build`.
#   Example: VITE_API_URL=https://api.your-deployed-domain.com
#
VITE_API_URL=http://127.0.0.1:8000
